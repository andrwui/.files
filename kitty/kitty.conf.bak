background #080808
shell_integration no-cursor
cursor_shape block
# font_family Geist Mono 
confirm_os_window_close 0

symbol_map U+1F300-U+1F5FF,U+1F600-U+1F64F,U+1F680-U+1F6FF,U+1F900-U+1F9FF,U+1FA00-U+1FAFF Apple Color Emoji



# BEGIN_KITTY_FONTS
font_family      family="CommitMono"
bold_font        family=CommitMono
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS