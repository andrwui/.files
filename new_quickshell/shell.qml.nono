import QtQuick
import Quickshell
import qs.config
import qs.components
import qs.state

Scope {
    id: root

    PanelWindow {
        id: bar
        color: 'green'

        implicitHeight: 800
        implicitWidth: 200
        exclusiveZone: 35

        margins.left: 5
        margins.top: 5

        Rectangle {
            color: Config.colors.secondaryLight
            height: 500
            width: parent.width

            PopupSelect {
                id: popup
                items: CalendarState.years

                value: CalendarState.currentYear
                onChange: index => {
                    CalendarState.currentYear = index;
                }

                width: 100
                height: 50

                openHeight: 100
            }
        }
    }
}
